SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
GROQ_API_KEY=gsk_...

# Optional overrides
# BAYMON_TEXT_MODEL=openai/gpt-oss-120b
# BAYMON_STT_MODEL=whisper-large-v3-turbo
# BAYMON_TTS_MODEL=canopylabs/orpheus-v1-english
# BAYMON_TTS_VOICE=troy
# BAYMON_USER_ID=<your auth.users id; enables long-term memory>
# Mic tuning (run `uv run baymon --mic-check` to see levels)
# BAYMON_MIC_RATIO=1.5          # lower = more sensitive to quiet speech
# BAYMON_MIC_THRESHOLD=         # fixed loudness threshold instead of auto
# BAYMON_END_SILENCE_MS=1500    # silence that ends your turn

# API
# BAYMON_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# BAYMON_HOST=127.0.0.1
# BAYMON_PORT=8000
# BAYMON_RELOAD=true

# Test user for local frontend/API testing
# BAYMON_TEST_EMAIL=
# BAYMON_TEST_PASSWORD=
